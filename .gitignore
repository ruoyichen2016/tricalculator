/target
/.cargo-home
**/__pycache__/
*.pyc

# native character saves (runtime)
/characters/

# release / pack outputs
/dist/
/data/packs/*/

# Third-party packs transcribed into the canonical pack format.  The sources
# under data/packs/custom/ are other publishers' copyrighted material and are
# local-only, so their transcriptions are too: build them with
# `pcgen transpile`, never commit them.
/data/packs/transcribed/

!/data/packs/custom/
!/data/packs/custom/README.md
!/data/packs/custom/original/
!/data/packs/custom/original/README.md
!/data/packs/custom/curated/
!/data/packs/custom/curated/README.md
/data/packs/custom/original/*
!/data/packs/custom/original/README.md
/data/packs/custom/curated/*
!/data/packs/custom/curated/README.md


# generated PF-as-3.5e extension materialisation lives under raw/ data,
# never in the repo
extensions/pf35e/**/rsrd_pf35e.pcc
