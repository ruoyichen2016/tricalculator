{
  "format": "gladius.module/1",
  "sources": {
    "phb2_expanded": {
      "title": "Player's Handbook II",
      "reference": "https://dtdnd.neocities.org/books/player/PlayersHandbookII.pdf",
      "locator": "Dragon Shaman pp.11-18, Duskblade pp.19-24, Knight pp.24-30; original class tables 1-2/1-3/1-4 and Duskblade printed spell list. Enervate resolves to Enervation; named hands use SRD names. The printed tables, not LST KNOWN rows, govern learning choices."
    },
    "srd-tactical": {
      "title": "Revised SRD: Shocking Grasp",
      "reference": "https://www.d20srd.org/srd/spells/shockingGrasp.htm",
      "locator": "Touch, standard action, electricity 1d6/CL (max 5d6), no save, SR yes; creature or object."
    },
    "srd-vampiric-touch": {
      "title": "Revised SRD: Vampiric Touch",
      "reference": "https://www.d20srd.org/srd/spells/vampiricTouch.htm",
      "locator": "Complete spell entry: targets, defense, damage and ongoing effects."
    },
    "srd-chill-touch": {
      "title": "Revised SRD: Chill Touch",
      "reference": "https://www.d20srd.org/srd/spells/chillTouch.htm",
      "locator": "Complete spell entry: targets, defense, damage and ongoing effects."
    },
    "srd-touch-of-fatigue": {
      "title": "Revised SRD: Touch of Fatigue",
      "reference": "https://www.d20srd.org/srd/spells/touchOfFatigue.htm",
      "locator": "Complete spell entry: targets, defense, damage and ongoing effects."
    },
    "srd-touch-of-idiocy": {
      "title": "Revised SRD: Touch of Idiocy",
      "reference": "https://www.d20srd.org/srd/spells/touchOfIdiocy.htm",
      "locator": "Complete spell entry: targets, defense, damage and ongoing effects."
    },
    "srd-ghoul-touch": {
      "title": "Revised SRD: Ghoul Touch",
      "reference": "https://www.d20srd.org/srd/spells/ghoulTouch.htm",
      "locator": "Complete spell entry: targets, defense, damage and ongoing effects."
    },
    "phb2-touch-actions": {
      "title": "Player's Handbook II",
      "reference": "https://dtdnd.neocities.org/books/player/PlayersHandbookII.pdf",
      "locator": "p.110 Dimension Hop and Dispelling Touch; pp.20-21 Arcane Channeling; dispel check uses ordinary dispel DC 11+effect CL."
    },
    "srd-physical-dr": {
      "title": "Revised SRD: Damage Reduction",
      "reference": "https://www.d20srd.org/srd/specialAbilities.htm#damageReduction",
      "locator": "Weapon damage traits, material and alignment; combined and alternative bypasses; highest applicable DR; spell damage is separate."
    },
    "wotc-channeling-faq": {
      "title": "D&D 3.5 Main FAQ (Wizards of the Coast, 2008-06-30)",
      "reference": "https://www.d20pfsrd.com/wp-content/uploads/sites/12/2017/01/Main35FAQv06302008.pdf",
      "locator": "p.17: a missed standard channel retains its charge; full channel expires at round end; one touch for standard multi-touch channeling; each full-attack target affected once. FAQ clarification supplements PHB II pp.20-21."
    },
    "srd-held-touch": {
      "title": "Revised SRD: Touch Spells in Combat; Attacks of Opportunity",
      "reference": "https://www.d20srd.org/srd/combat/actionsInCombat.htm#touchSpellsinCombat",
      "locator": "Miss retains charge; contact expends it; casting another spell dissipates it. Ordinary Chill Touch has CL uses, independent of channeling limits."
    }
  },
