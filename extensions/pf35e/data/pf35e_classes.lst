# Pathfinder-as-3.5e extension: classes rewritten in 3.5e PCGen syntax.
#
# This file deliberately uses ONLY 3.5e tags the pcgen-rust engine already
# understands (HD, TYPE, MAXLEVEL, STARTSKILLPTS, SPELLSTAT, MEMORIZE,
# BONUS:COMBAT/BONUS:SAVE/BONUS:VAR, CAST/KNOWN).  Anything that cannot be
# expressed this way is listed in ../../docs/PF35E_EXTENSION.md as a known gap.
#
# Provenance: Pathfinder RPG Core Rulebook (Paizo), OGL/Community Use.
# These are rewrite files, not copies of the PCGen Pathfinder dataset.

# --- Cleric ---------------------------------------------------------------
# PF changes: Channel Energy replaces Turn Undead; domains remain a choice.
# BAB / saves / HD formulas are identical to 3.5e Cleric.
CLASS:ClericHD:8TYPE:Base.PCMAXLEVEL:20SOURCEPAGE:PF-CRB p.38DEFINE:ClericLVL|0BONUS:COMBAT|BASEAB|classlevel("APPLIEDAS=NONEPIC")/2+2BONUS:SAVE|BASE.Fortitude,BASE.Will|classlevel("APPLIEDAS=NONEPIC")/2+2BONUS:SAVE|BASE.Reflex|classlevel("APPLIEDAS=NONEPIC")/3BONUS:VAR|ClericLVL|CL
CLASS:ClericSTARTSKILLPTS:2
CLASS:ClericSPELLSTAT:WISMEMORIZE:YES
1CAST:0,1KNOWN:3
2CAST:0,2
3CAST:0,2,1
4CAST:0,3,2
5CAST:0,3,2,1
6CAST:0,3,3,2
7CAST:0,4,3,2,1
8CAST:0,4,3,3,2
9CAST:0,4,4,3,2,1
10CAST:0,4,4,3,3,2
11CAST:0,5,4,3,3,2,1
12CAST:0,5,4,4,3,2,2
13CAST:0,5,4,4,4,3,2,1
14CAST:0,5,5,4,4,3,2,2
15CAST:0,5,5,4,4,4,3,2,1
16CAST:0,5,5,5,4,4,3,2,2
17CAST:0,5,5,5,4,4,4,3,2,1
18CAST:0,5,5,5,5,4,4,3,2,2
19CAST:0,5,5,5,5,5,4,4,3,3
20CAST:0,5,5,5,5,5,5,4,4,4

# --- Fighter --------------------------------------------------------------
# PF changes: Bravery, Armor Training, Weapon Training replace 3.5e bonus
# feat schedule in places; the raw BAB/HD/saves are 3.5e-identical.
CLASS:FighterHD:10TYPE:Base.PCMAXLEVEL:20SOURCEPAGE:PF-CRB p.51DEFINE:FighterLVL|0BONUS:COMBAT|BASEAB|classlevel("APPLIEDAS=NONEPIC")BONUS:SAVE|BASE.Fortitude|classlevel("APPLIEDAS=NONEPIC")/2+2BONUS:SAVE|BASE.Reflex,BASE.Will|classlevel("APPLIEDAS=NONEPIC")/3BONUS:VAR|FighterLVL|CL
CLASS:FighterSTARTSKILLPTS:2

# --- Wizard ---------------------------------------------------------------
# PF changes: arcane bond / school powers; BAB/HD/saves are 3.5e-identical.
CLASS:WizardHD:6TYPE:Base.PCMAXLEVEL:20SOURCEPAGE:PF-CRB p.77DEFINE:WizardLVL|0BONUS:COMBAT|BASEAB|classlevel("APPLIEDAS=NONEPIC")/2BONUS:SAVE|BASE.Will|classlevel("APPLIEDAS=NONEPIC")/2+2BONUS:SAVE|BASE.Fortitude,BASE.Reflex|classlevel("APPLIEDAS=NONEPIC")/3BONUS:VAR|WizardLVL|CL
CLASS:WizardSTARTSKILLPTS:2
CLASS:WizardSPELLSTAT:INTMEMORIZE:YES
1CAST:3,1
2CAST:4,2
3CAST:4,2,1
4CAST:4,3,2
5CAST:4,3,2,1
6CAST:4,3,3,2
7CAST:4,4,3,2,1
8CAST:4,4,3,3,2
9CAST:4,4,4,3,2,1
10CAST:4,4,4,3,3,2
11CAST:4,4,4,4,3,2,1
12CAST:4,4,4,4,3,3,2
13CAST:4,4,4,4,4,3,2,1
14CAST:4,4,4,4,4,3,3,2
15CAST:4,4,4,4,4,4,3,2,1
16CAST:4,4,4,4,4,4,3,3,2
17CAST:4,4,4,4,4,4,4,3,2,1
18CAST:4,4,4,4,4,4,4,3,3,2
19CAST:4,4,4,4,4,4,4,4,3,3
20CAST:4,4,4,4,4,4,4,4,4,4
